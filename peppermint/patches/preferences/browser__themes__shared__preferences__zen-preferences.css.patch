+.zenNotepadOption {
+  margin-bottom: 10px;
+  display: flex;
+  align-items: center;
+
+  & > label {
+    font-size: 14px;
+    color: light-dark(rgba(0, 0, 0, 0.7), rgba(255, 255, 255, 0.7));
+    width: 100%;
+  }
+
+  & > vbox {
+    width: fit-content;
+    justify-content: end;
+    min-width: 70%;
+  }
+
+  & input {
+    padding: 5px;
+    border-radius: 5px;
+    border: 1px solid var(--zen-colors-border);
+    overflow: hidden;
+    white-space: nowrap;
+    text-overflow: ellipsis;
+    user-select: none;
+    cursor: text;
+    background: transparent;
+    transition: border-color 0.1s;
+
+    &:focus {
+      border-color: transparent;
