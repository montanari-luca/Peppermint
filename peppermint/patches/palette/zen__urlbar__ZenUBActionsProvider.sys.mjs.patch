+  /**
+   * Peppermint: actions can list other words people search for (a comma
+   * separated `keywords` string). The best of them counts, a little below an
+   * equally good match on the label.
+   *
+   * @param {object} action The action to score.
+   * @param {string} query The user's search query.
+   * @returns {number} The score of the best keyword.
+   */
+  #keywordScore(action, query) {
+    const keywords = action.keywords;
+    if (!keywords) {
+      return 0;
+    }
+    let best = 0;
+    for (const keyword of keywords.split(",")) {
+      best = Math.max(best, this.#calculateFuzzyScore(keyword.trim(), query));
+    }
+    return best * 0.9;
   }
 
