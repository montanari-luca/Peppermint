zen-theme-picker-reset-default =
    .label = Reset to default

## Isolated spaces (src/peppermint/isolated-spaces). A container is Firefox's
## separate cookie jar; Zen's interface calls it a profile.

peppermint-space-isolate =
    .label = Isolate this space
peppermint-space-isolate-title = Isolate { $name }?
# $container is the name of the container the space already uses.
peppermint-space-isolate-adopt-body = { $name } keeps its profile, { $container }, and no other space can use it. Your sign-ins in this space stay as they are.
peppermint-space-isolate-new-body = { $name } gets a profile of its own, so its cookies and sign-ins stay apart from your other spaces. Its tabs reload in it, and sites in this space will ask you to sign in again.
peppermint-space-isolate-button = Isolate
peppermint-space-isolated-locked = This space is isolated. Turn off “Isolate this space” to choose another profile.
peppermint-space-own-container = Own profile
peppermint-space-delete-isolated-body = Are you sure you want to delete { $name }? Its tabs, and the cookies, sign-ins and site data of its profile, will be deleted. This cannot be undone.
