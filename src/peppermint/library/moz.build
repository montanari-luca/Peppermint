# Zen's Library loads its sections into the window, so these are window
# modules, not system modules.
MOZ_SRC_FILES += [
    "PeppermintLibraryArchiveSection.mjs",
    "PeppermintLibrarySavedSection.mjs",
    "PeppermintLibrarySections.mjs",
    "PeppermintLibraryUtils.mjs",
]
